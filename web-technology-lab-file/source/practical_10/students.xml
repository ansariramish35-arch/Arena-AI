<?xml version="1.0" encoding="UTF-8"?>
<!-- Practical 10 : XML program for the creation of a DTD which specifies a set of
rules. The DTD is written INSIDE this file (internal DTD); every rule must be
followed, otherwise the document is reported as "not valid". -->
<!DOCTYPE students [
<!-- RULE 1 : the root <students> contains one or more <student> -->
<!ELEMENT students (student+)>
<!-- RULE 2 : children of <student> in THIS ORDER; address? and remarks? optional -->
<!ELEMENT student (name, rollno, course, semester, email, address?, remarks?)>
<!-- RULE 3 : every <student> must have an id attribute (ID type, #REQUIRED) -->
<!ATTLIST student id ID #REQUIRED type (regular | lateral) "regular"
active (yes | no) #IMPLIED>
<!-- RULE 4 : these elements contain only parsed text -->
<!ELEMENT name (#PCDATA)>
<!ELEMENT rollno (#PCDATA)>
<!ELEMENT course (#PCDATA)>
<!ELEMENT semester (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!-- RULE 5 : <address> is a container and its order is also fixed -->
<!ELEMENT address (city, state, pin)>
<!ELEMENT city (#PCDATA)>
<!ELEMENT state (#PCDATA)>
<!ELEMENT pin (#PCDATA)>
<!-- RULE 6 : <remarks> may contain unparsed character data (CDATA) -->
<!ELEMENT remarks (#PCDATA | note)*>
<!ELEMENT note (#PCDATA)>
<!-- RULE 7 : a text entity that can be reused anywhere in the document -->
<!ENTITY college "Name of the College">
]>
<students>
<student id="S01" type="regular" active="yes"><name>Student Name One</name>
<rollno>CSE2101</rollno><course>B.Tech (Computer Science &amp; Engineering)</course>
<semester>V</semester><email>student1@college.ac.in</email>
<address><city>Lucknow</city><state>Uttar Pradesh</state><pin>226001</pin></address>
</student>
<student id="S02" type="regular" active="yes"><name>Student Name Two</name>
<rollno>CSE2102</rollno><course>B.Tech (Computer Science &amp; Engineering)</course>
<semester>V</semester><email>student2@college.ac.in</email>
<address><city>Kanpur</city><state>Uttar Pradesh</state><pin>208001</pin></address>
</student>
<!-- address is optional, so it is not given for this student -->
<student id="S03" type="lateral"><name>Student Name Three</name>
<rollno>CSE2103</rollno><course>B.Tech (Information Technology)</course>
<semester>V</semester><email>student3@college.ac.in</email>
<remarks><![CDATA[ Lateral entry student. Marks & grades are pending. ]]></remarks>
</student>
</students>
