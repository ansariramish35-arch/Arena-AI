<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================
     Practical 10 : XML program for the creation of a DTD which
     specifies a set of rules.
     Here the DTD is written INSIDE the XML file (internal DTD).
     Every rule written below must be followed by the document,
     otherwise the XML file is reported as "not valid".
     ========================================================== -->

<!DOCTYPE students [

    <!-- RULE 1 : the root element <students> contains one or more <student> -->
    <!ELEMENT students (student+)>

    <!-- RULE 2 : each <student> must contain these child elements IN THIS ORDER.
         "address" and "remarks" are optional because of the ? symbol. -->
    <!ELEMENT student (name, rollno, course, semester, email, address?, remarks?)>

    <!-- RULE 3 : every <student> must have an "id" attribute (ID type, REQUIRED) -->
    <!ATTLIST student
        id      ID      #REQUIRED
        type    (regular | lateral)  "regular"
        active  (yes | no)           #IMPLIED
    >

    <!-- RULE 4 : these elements contain only parsed text -->
    <!ELEMENT name     (#PCDATA)>
    <!ELEMENT rollno   (#PCDATA)>
    <!ELEMENT course   (#PCDATA)>
    <!ELEMENT semester (#PCDATA)>
    <!ELEMENT email    (#PCDATA)>

    <!-- RULE 5 : <address> is a container; its order is also fixed -->
    <!ELEMENT address (city, state, pin)>
    <!ELEMENT city (#PCDATA)>
    <!ELEMENT state (#PCDATA)>
    <!ELEMENT pin  (#PCDATA)>

    <!-- RULE 6 : <remarks> may contain unparsed character data (CDATA) -->
    <!ELEMENT remarks (#PCDATA | note)*>
    <!ELEMENT note    (#PCDATA)>

    <!-- RULE 7 : a text entity that can be reused anywhere in the document -->
    <!ENTITY college "Name of the College">

]>

